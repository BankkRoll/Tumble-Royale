# Shared by the API, matchmaker and game server. Each loads this file after its
# own apps/<name>/.env; real environment variables always win.
# `pnpm setup:env` copies it to .env and replaces every change-me with a random secret.

# --- Required in production --------------------------------------------------
# Signs API access tokens; the matchmaker verifies them (32+ chars).
JWT_SECRET=change-me
# Signs game server results and matchmaker ban lookups sent to the API (16+ chars).
INTERNAL_HMAC_SECRET=change-me
# Signs matchmaker join tickets; game servers verify them (16+ chars).
GAME_TICKET_SECRET=change-me
# Game servers present it to register with the matchmaker; it also signs kicks (16+ chars).
GAME_SERVER_SECRET=change-me

# --- Service URLs ------------------------------------------------------------
# Web client origin: CORS, invite links and sign-in redirects.
PUBLIC_WEB_URL=http://localhost:5173
# Account API, called by the matchmaker and game servers.
API_URL=http://localhost:7360
# Matchmaker the game server registers with (the API also probes it for /status).
MATCHMAKER_URL=http://localhost:7370
