# API overrides. Secrets and shared URLs (JWT_SECRET, INTERNAL_HMAC_SECRET,
# PUBLIC_WEB_URL) live in the root .env. Uncomment a line to change its default.

# --- Required in production --------------------------------------------------
# development | test | production. Production refuses to boot without REDIS_URL.
# NODE_ENV=production
# Redis for parties, presence, leaderboards and pub/sub; unset → in-process (dev only).
# REDIS_URL=redis://localhost:6379
# Postgres; unset → embedded PGlite in PGLITE_DIR.
# DATABASE_URL=postgres://tumble:tumble@localhost:5432/tumble
# Public origin of this API, used to build OAuth redirect URIs.
# PUBLIC_API_URL=http://localhost:7360

# --- Optional features (unset → off) -----------------------------------------
# Bearer for the /internal/bans, flags, reports and ledger admin routes.
# ADMIN_TOKEN=
# Discord / Google sign-in.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Magic-link relay: smtp://user:pass@host:587 (STARTTLS) or smtps://…:465; unset → console in dev.
# SMTP_URL=
# SMTP_FROM=Tumble Royale <no-reply@example.com>
# Stripe Checkout for Gem packs; unset → a fake provider that completes instantly.
# The webhook secret is required whenever the key is set (refunds/disputes arrive by webhook).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Operations ---------------------------------------------------------------
# 1 lets production run on embedded PGlite (single instance; back up PGLITE_DIR while stopped).
# ALLOW_EMBEDDED_DB=
# Postgres pool size per API instance.
# DB_POOL_MAX=10
# 0 skips migrations at boot (run `pnpm --filter @tumble/api migrate` as a deploy step instead).
# MIGRATE_ON_BOOT=1
# /metrics, as on the game server: a private listener without auth (INTERNAL_PORT,
# keep it off the public network) and/or a bearer on the public port (METRICS_TOKEN,
# 16+ chars). With neither it is open in development and 404 in production.
# INTERNAL_PORT=
# INTERNAL_HOST=
# METRICS_TOKEN=
# Sentry-compatible DSN for crash reports.
# SENTRY_DSN=
# Retention job: interval, days past expiry before sessions go, non-audit event age,
# and guest accounts unused this long (0 = keep forever).
# RETENTION_INTERVAL_MINUTES=360
# RETENTION_SESSION_GRACE_DAYS=7
# RETENTION_EVENTS_DAYS=90
# RETENTION_GUEST_DAYS=0

# --- Tuning ------------------------------------------------------------------
# PORT=7360
# HOST=0.0.0.0
# Comma-separated CORS allow-list; default: any origin in dev, PUBLIC_WEB_URL in production.
# CORS_ORIGINS=
# PGLITE_DIR=./.data/pglite
# 1 lets production run on the in-process store (single instance, state lost on restart).
# ALLOW_MEMORY_STORE=
# NAME_CHANGE_COOLDOWN_DAYS=30
# Reverse proxies allowed to set X-Forwarded-For. Unset/false: none, the socket
# address is the client. A number: that many proxies in front (load balancer →
# ingress = 2). Or proxy IPs/CIDRs (10.0.0.0/8,fd00::/8; loopback, uniquelocal).
# `true` is refused: clients could forge their address and dodge rate limits.
# TRUST_PROXY=1
# Requests per minute per token or IP; shared by every instance when REDIS_URL is set.
# RATE_LIMIT_MAX=300
# How long a player stays online after their last realtime connection closes.
# PRESENCE_GRACE_MS=8000
# Abuse limits. Realtime handshakes per client IP and per account per minute
# (shared across instances with REDIS_URL), open realtime sockets per account
# and per IP on each instance, new guest accounts per IP per hour, how old a
# guest account must be before it may post in global chat (linked accounts
# post at once), and global chat lines per IP per 10 s across all accounts.
# WS_IP_UPGRADES_PER_MINUTE=60
# WS_USER_UPGRADES_PER_MINUTE=20
# WS_MAX_SOCKETS_PER_USER=5
# WS_MAX_SOCKETS_PER_IP=50
# GUEST_SIGNUPS_PER_IP_HOUR=10
# GLOBAL_CHAT_MIN_ACCOUNT_AGE_MINUTES=10
# GLOBAL_CHAT_IP_MAX=10
# Voice chat ICE servers (stun:/turn:/turns: URLs, comma-separated) and the TURN
# REST secret shared with coturn. Production keeps voice unavailable without a
# TURN URL unless VOICE_REQUIRE_TURN=0; development allows direct connections.
# VOICE_ICE_SERVERS=stun:localhost:3478,turn:localhost:3478
# VOICE_TURN_SECRET=
# VOICE_REQUIRE_TURN=
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
