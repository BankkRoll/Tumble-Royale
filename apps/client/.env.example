# Client build settings. VITE_* values are baked into the bundle at build time,
# so never put secrets here. Uncomment a line to change its default.

# --- Optional build-time overrides --------------------------------------------
# Production builds default to same-origin /api, /mm and /gs/ws and read
# /config.json at boot ({"apiUrl","matchmakerUrl","gameServerUrl","reportErrors","sentryDsn"}),
# so one build serves any domain. These bake fixed values in instead.
# Account API base URL.
# VITE_API_URL=https://api.example.com
# Matchmaker base URL.
# VITE_MATCHMAKER_URL=https://mm.example.com
# Game server WebSocket URL; unset → /gs/ws on the page's own origin.
# VITE_GAME_SERVER_URL=wss://gs.example.com/ws
# Sentry-compatible DSN for client crash reports (config.json sentryDsn wins).
# VITE_SENTRY_DSN=

# --- Dev only ----------------------------------------------------------------
# Where `vite dev` proxies /gs (the game server's HTTP + WebSocket).
# GAME_SERVER_URL=http://localhost:7350
