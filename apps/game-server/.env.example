# Game server overrides. Secrets and shared URLs (GAME_TICKET_SECRET,
# GAME_SERVER_SECRET, INTERNAL_HMAC_SECRET, API_URL, MATCHMAKER_URL) live in the
# root .env. Uncomment a line to change its default.

# --- Required in production --------------------------------------------------
# development | test | production. Production requires tickets and reports
# results only when API_URL is set.
# NODE_ENV=production
# WebSocket URL players connect to, advertised to the matchmaker.
# PUBLIC_WS_URL=wss://gs-1.example.com/ws
# Id the matchmaker knows this server by; default gs-<hostname>-<port>.
# SERVER_ID=
# REGION=na

# --- Optional ----------------------------------------------------------------
# HTTP base where the matchmaker reaches POST /internal/kick (host kicks). Set it
# whenever PUBLIC_WS_URL does not also route plain HTTP to this server (a
# WebSocket-only proxy rule, a CDN). Unset → PUBLIC_WS_URL minus its trailing
# /ws, keeping any proxy prefix (wss://play.example/gs/ws → https://play.example/gs).
# CONTROL_URL=https://gs-1.internal:7350
# Durable queue of undelivered results.
# RESULTS_OUTBOX_DIR=./.data/results-outbox
# 0 turns results reporting off.
# REPORT_RESULTS=1
# 1/0: accept joins without a matchmaker ticket; default on except in production.
# ALLOW_UNTICKETED=

# --- Exposure ----------------------------------------------------------------
# /metrics and /rooms reveal load and match ids. In production they are served
# only on INTERNAL_PORT (no auth; keep it off the public network) or on the
# public port with `Authorization: Bearer $METRICS_TOKEN` (16+ chars). With
# neither they answer 404. /debug/* never runs in production.
# INTERNAL_PORT=9350
# INTERNAL_HOST=10.0.0.4
# METRICS_TOKEN=
# Browser origins allowed CORS on /health and WebSocket upgrades (comma-separated).
# Default: any in development, PUBLIC_WEB_URL (root .env) in production. Clients
# without an Origin header (bots, load tests) are judged by their join ticket.
# ALLOWED_ORIGINS=
# Reverse proxies allowed to set X-Forwarded-For: unset (none), a hop count, or
# proxy IPs/CIDRs (10.0.0.0/8,fd00::/8). `true` is refused (clients could forge it).
# TRUST_PROXY=1
# New sockets must send their Hello within this long.
# HELLO_TIMEOUT_MS=5000
# Sockets per client address still waiting for their Hello; more get HTTP 429.
# MAX_PENDING_PER_IP=8

# --- Operations ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent (JSON lines on stdout).
# LOG_LEVEL=info
# Sentry-compatible DSN for crash reports.
# SENTRY_DSN=
# SIGTERM drain: wait for late players, let shows finish, retry undelivered results.
# Orchestrator grace periods (docker stop_grace_period) must exceed their sum.
# DRAIN_SETTLE_MS=15000
# DRAIN_TIMEOUT_MS=900000
# OUTBOX_FLUSH_MS=15000

# --- Tuning ------------------------------------------------------------------
# PORT=7350
# Show size including bots for unticketed rooms.
# ROOM_CAPACITY=40
# MAX_ROOMS=10
# Seats (bots included) advertised to the matchmaker; default MAX_ROOMS × ROOM_CAPACITY.
# SERVER_CAPACITY=
# Wait after the first human before filling with bots.
# FILL_WAIT_MS=25000
# Start early once this many humans joined; default ROOM_CAPACITY.
# START_AT_HUMANS=
# Matchmade rooms start when every ticketed human joined, or after this.
# TICKET_FILL_WAIT_MS=15000
# Playlist for unticketed shows; default Main Show.
# PLAYLIST=

# --- Dev only ----------------------------------------------------------------
# 1 swaps in the capsule stand-in sim (load tests), with rounds of PLAY_SECONDS.
# GS_DEV=1
# PLAY_SECONDS=120
