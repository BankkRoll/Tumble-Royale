    "ws": "8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
