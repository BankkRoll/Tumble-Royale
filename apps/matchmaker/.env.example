# Matchmaker overrides. Secrets and shared URLs (JWT_SECRET, GAME_TICKET_SECRET,
# GAME_SERVER_SECRET, INTERNAL_HMAC_SECRET, API_URL, PUBLIC_WEB_URL) live in the
# root .env. Uncomment a line to change its default.

# --- Required in production --------------------------------------------------
# development | test | production. Production refuses to boot without REDIS_URL.
# NODE_ENV=production
# Shared state and tick lock for one or more instances; unset → in-process (dev only).
# REDIS_URL=redis://localhost:6379

# --- Operations ---------------------------------------------------------------
# /metrics, as on the game server: a private listener without auth (INTERNAL_PORT,
# keep it off the public network) and/or a bearer on the public port (METRICS_TOKEN,
# 16+ chars). With neither it is open in development and 404 in production.
# INTERNAL_PORT=
# INTERNAL_HOST=
# METRICS_TOKEN=
# Sentry-compatible DSN for crash reports.
# SENTRY_DSN=

# --- Tuning ------------------------------------------------------------------
# PORT=7370
# HOST=0.0.0.0
# Game server used when none has registered; defaults to ws://localhost:7350 in dev.
# DEFAULT_GAME_SERVER_URL=
# 1 lets production run without API_URL (no ban checks, maintenance or playlist windows).
# ALLOW_STANDALONE=
# Comma-separated browser origins; default: any in dev, PUBLIC_WEB_URL in production.
# ALLOWED_ORIGINS=
# 1 lets production run on the in-process store (single instance, state lost on restart).
# ALLOW_MEMORY_STORE=
# Lobby size when a ticket does not set one.
# TARGET_SIZE=100
# Release a lobby with bots after this wait; the shorter one once HOT_THRESHOLD players search a region.
# MAX_WAIT_MS=25000
# HOT_MAX_WAIT_MS=12000
# HOT_THRESHOLD=200
# How long a ready lobby waits for a server in its own region before trying others.
# REGION_FALLBACK_MS=10000
# Reverse proxies allowed to set X-Forwarded-For. Unset/false: none, the socket
# address is the client (correct when nothing sits in front). A number: that many
# proxies in front (load balancer → ingress = 2). Or a comma-separated list of
# proxy IPs/CIDRs (10.0.0.0/8,fd00::/8; also loopback, linklocal, uniquelocal).
# `true` is refused: it would let clients forge their address and dodge limits.
# TRUST_PROXY=1
# Requests per minute per IP, and queue/lobby changes per minute per player.
# With REDIS_URL the windows are shared by every instance.
# RATE_LIMIT_MAX=120
# USER_RATE_LIMIT_MAX=30
# TICK_MS=500
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
