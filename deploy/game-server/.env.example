# Settings for an extra game server host (deploy/game-server/docker-compose.yml).
# Copy to .env next to this file and replace example.com and every change-me.
#
# REQUIRED lines must be filled in. OPTIONAL lines show their default; uncomment
# one to change it. docs/SELF_HOSTING.md, "Environment reference", documents
# every variable.

# --- This server ----------------------------------------------------------------
# REQUIRED. Its own public hostname; DNS must point at this host.
GS_DOMAIN=gs-eu.example.com
# OPTIONAL. Let's Encrypt account email for certificate expiry notices.
ACME_EMAIL=
# REQUIRED. production refuses joins without a matchmaker ticket.
NODE_ENV=production
# REQUIRED. What players connect to; the matchmaker hands it out in join tickets.
PUBLIC_WS_URL=wss://gs-eu.example.com/ws
# REQUIRED. Unique among all game servers.
SERVER_ID=gs-eu-1
# REQUIRED. na | eu | asia | sa | oce
REGION=eu
# REQUIRED. Caddy on this host is the one proxy in front of the game server.
TRUST_PROXY=1
# OPTIONAL. Where the matchmaker reaches this server's kick endpoint
# (default: PUBLIC_WS_URL without its /ws, here https://gs-eu.example.com).
# CONTROL_URL=https://gs-eu.example.com

# --- The main server ------------------------------------------------------------
# REQUIRED. The main server's web origin (allowed browser origin by default).
PUBLIC_WEB_URL=https://example.com
# OPTIONAL (default: PUBLIC_WEB_URL). Browser origins allowed to connect, comma-separated.
ALLOWED_ORIGINS=https://example.com
# REQUIRED. The matchmaker this server registers with, and the API it reports results to.
MATCHMAKER_URL=https://example.com/mm
API_URL=https://example.com/api

# --- Secrets: copy these four from the main server's deploy/.env ----------------
# REQUIRED. Verifies join tickets.
GAME_TICKET_SECRET=change-me
# REQUIRED. Registers with the matchmaker and signs kicks.
GAME_SERVER_SECRET=change-me
# REQUIRED. Signs the results sent to the API: the main server's
# GAME_SERVER_HMAC_SECRET (its INTERNAL_HMAC_SECRET only for setups that have none).
GAME_SERVER_HMAC_SECRET=change-me
# INTERNAL_HMAC_SECRET=
# OPTIONAL. Bearer for /metrics and /rooms on this server.
METRICS_TOKEN=change-me

# --- Monitoring (OPTIONAL) ------------------------------------------------------
# Sentry-compatible DSN for crash reports.
# SENTRY_DSN=
# fatal | error | warn | info | debug | trace | silent (default: info).
# LOG_LEVEL=info
# A private /metrics and /rooms listener without auth (default: none); keep it off the internet.
# INTERNAL_PORT=9350
# INTERNAL_HOST=0.0.0.0

# --- Capacity and shows (OPTIONAL) ----------------------------------------------
# Show size for unticketed rooms (default/max: 100), rooms per process (default: 3)
# and seats advertised to the matchmaker (default: MAX_ROOMS x ROOM_CAPACITY).
# ROOM_CAPACITY=100
# MAX_ROOMS=3
# SERVER_CAPACITY=
# Bot fill wait after the first human (default: 25000 ms); start early at this many humans.
# FILL_WAIT_MS=25000
# START_AT_HUMANS=
# Matchmade rooms start when every ticketed human joined, or after this (default: 15000 ms).
# TICKET_FILL_WAIT_MS=15000
# Playlist for unticketed shows (default: Main Show).
# PLAYLIST=
# 1 accepts players without a matchmaker ticket (default: 0 in production).
# ALLOW_UNTICKETED=0
# 1 runs without results reporting to the API (no maintenance or kill switches).
# ALLOW_STANDALONE=
# 0 stops reporting results to the API (default: 1).
# REPORT_RESULTS=1
# Hello deadline for new sockets (default: 5000 ms) and unhandshaken sockets per IP (default: 8).
# HELLO_TIMEOUT_MS=5000
# MAX_PENDING_PER_IP=8
# SIGTERM drain: wait for late players, let shows finish, retry undelivered
# results. stop_grace_period in docker-compose.yml must exceed their sum.
# DRAIN_SETTLE_MS=15000
# DRAIN_TIMEOUT_MS=900000
# OUTBOX_FLUSH_MS=15000

# --- Edge and image (OPTIONAL) --------------------------------------------------
# Image tag to build and run (default: latest).
# TAG=latest
# Caddy site address and global options (defaults: GS_DOMAIN, and the ACME_EMAIL line).
# SITE_ADDRESS=gs-eu.example.com
# CADDY_GLOBAL_OPTIONS=
# Where Caddy proxies (default: the game-server service).
# GAME_SERVER_UPSTREAM=game-server:7350

# --- Set by docker-compose.yml (reference only; leave these commented) ----------
# PORT=7350
# RESULTS_OUTBOX_DIR=/data/results-outbox

# --- Development only -----------------------------------------------------------
# The capsule stand-in sim for load tests; never in production.
# GS_DEV=
# PLAY_SECONDS=
