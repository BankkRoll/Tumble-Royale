{
  "name": "tumble-royale",
  "version": "0.1.0",
  "description": "A browser-native, physics-driven 100-player party royale built with three.js WebGPU, Rapier and server-authoritative netcode.",
  "license": "MIT",
  "author": "BankkRoll",
  "homepage": "https://github.com/BankkRoll/Tumble-Royale#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BankkRoll/Tumble-Royale.git"
  },
  "bugs": {
    "url": "https://github.com/BankkRoll/Tumble-Royale/issues"
  },
  "keywords": [
    "game",
    "party-game",
    "battle-royale",
    "threejs",
    "webgpu",
    "rapier",
    "multiplayer",
    "netcode",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "admin": "node scripts/admin.mjs",
    "predev": "node scripts/setup-env.mjs --if-missing",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test && node --test \"scripts/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
